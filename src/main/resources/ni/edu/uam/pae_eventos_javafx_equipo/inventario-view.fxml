<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox spacing="15" alignment="TOP_CENTER" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.pae_eventos_javafx_equipo.controller.InventarioController"
      style="-fx-padding: 20;">

    <Label text="Reto 1: Inventario de Pulpería" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Cantidad:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="txtCantidad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Guardar Producto" onAction="#guardarProducto" style="-fx-base: #4CAF50; -fx-text-fill: white;"/>
        <Button text="Volver al Menú" onAction="#volverAlMenu"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER">
        <Label text="Buscar por Código (Enter):"/>
        <TextField fx:id="txtBuscar" onKeyPressed="#buscarProducto" promptText="Escriba código y pulse Enter..."/>
    </HBox>

    <TableView fx:id="tableInventario" prefHeight="200" prefWidth="450">
        <columns>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="100"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colPrecio" text="Precio" prefWidth="90"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100"/>
        </columns>
    </TableView>

</VBox>