<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.pae_eventos_javafx_equipo.controller.ArtesaniaController">

    <MenuBar>
        <menus>
            <Menu text="Catálogo">
                <items>
                    <MenuItem text="Ver Catálogo" onAction="#menuCatalogo"/>
                </items>
            </Menu>
            <Menu text="Ventas">
                <items>
                    <MenuItem text="Registrar Venta" onAction="#menuVentas"/>
                </items>
            </Menu>
            <Menu text="Ayuda">
                <items>
                    <MenuItem text="Acerca de" onAction="#menuAyuda"/>
                </items>
            </Menu>
        </menus>
    </MenuBar>

    <ToolBar>
        <Button text="Nuevo" onAction="#accionNuevo"/>
        <Button text="Guardar" onAction="#accionGuardar"/>
        <Button text="Buscar" onAction="#accionBuscar"/>
        <Separator/>
        <Button text="Volver al Menú" onAction="#volverAlMenu"/>
    </ToolBar>

    <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 15;">
        <Label text="Reto 3: Tienda de Artesanías" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="10" vgap="10" alignment="CENTER">
            <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Precio:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtPrecio" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Categoría:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="txtCategoria" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Ruta Imagen URL/File:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="txtImagenPath" promptText="file:/C:/... o URL web" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </GridPane>

        <TableView fx:id="tableArtesania" prefHeight="200" prefWidth="500">
            <columns>
                <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
                <TableColumn fx:id="colPrecio" text="Precio" prefWidth="80"/>
                <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100"/>
                <TableColumn fx:id="colImagen" text="Imagen" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>